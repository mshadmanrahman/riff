{
  "manifest_version": 3,
  "name": "Riff - Read the Whole LinkedIn Thread",
  "version": "1.4.0",
  "description": "The whole thread, not LinkedIn's sample. One click loads every comment on the post you're viewing, as clean text for your AI.",
  "permissions": ["activeTab", "clipboardWrite", "scripting", "storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "optional_host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/riff-16.png",
    "32": "icons/riff-32.png",
    "48": "icons/riff-48.png",
    "128": "icons/riff-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/riff-16.png",
      "32": "icons/riff-32.png",
      "48": "icons/riff-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["content-styles.css"],
      "run_at": "document_idle"
    }
  ]
}
